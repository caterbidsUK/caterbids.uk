# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# CaterBot image/plate analysis
AI_VISION_API_KEY=
AI_VISION_MODEL=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=

# CaterBot manual/spec source search
# Server-side only. Use one configured provider; do not expose keys with NEXT_PUBLIC_.
CATERBOT_SEARCH_PROVIDER=you
YOU_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPER_API_KEY=

# Make.com blog publishing API
CATERBIDS_BLOG_API_KEY=

# Email sending for development/testing.
# Gmail requires a Google App Password, not your normal Gmail password.
EMAIL_PROVIDER=gmail
GMAIL_USER=caterbidsuk@gmail.com
GMAIL_APP_PASSWORD=your_google_app_password_here
EMAIL_FROM="CaterBidsUK <caterbidsuk@gmail.com>"

# Optional Resend setup for production/later testing.
# Resend may require a verified sender/domain. If caterbidsuk@gmail.com is
# rejected by Resend, use Gmail SMTP for development email testing.
RESEND_API_KEY=your_resend_api_key_here

# Optional trust and verification providers
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_phone_number
COMPANIES_HOUSE_API_KEY=

# Site URL — used for Stripe redirects, auth callbacks, and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://caterbids.uk

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
